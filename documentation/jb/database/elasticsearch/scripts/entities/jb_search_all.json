{
  "domain": "jb",
  "module": "jb_business_jobsnow",
  "packageOfEntities": "com.jb.entities",
  "description": "Consultas 'search all' unificadas de todos os indices do Elasticsearch do dominio JB (bots do JobsNow). O nome do indice e derivado do nome da classe configuradora pelo CcpEntityFactory.mainEntityNameProducer: simpleName -> snake_case -> remove o prefixo ate 'entity_' (ex: JbEntityBotCommandStep -> jb_entity_bot_command_step -> bot_command_step).",
  "totalOfIndexes": 12,
  "unifiedSearchAll": {
    "comment": "Uma unica requisicao que varre TODOS os indices do dominio JB de uma vez. O campo _index no retorno identifica de qual entidade veio cada documento.",
    "method": "POST",
    "url": "/bot,bot_allowed_user,bot_command,bot_command_explanation,bot_command_name,bot_command_step,bot_command_step_end_message,bot_command_step_explanation,bot_command_step_flow_message,bot_command_step_session,bot_command_step_start_message,bot_explanation/_search",
    "body": {
      "size": 10000,
      "track_total_hits": true,
      "query": {
        "match_all": {}
      },
      "sort": [
        { "_index": "asc" },
        { "_doc": "asc" }
      ]
    }
  },
  "countByIndex": {
    "comment": "Contagem de documentos por indice do dominio JB, util para conferir se o search all trouxe tudo.",
    "method": "POST",
    "url": "/bot,bot_allowed_user,bot_command,bot_command_explanation,bot_command_name,bot_command_step,bot_command_step_end_message,bot_command_step_explanation,bot_command_step_flow_message,bot_command_step_session,bot_command_step_start_message,bot_explanation/_search",
    "body": {
      "size": 0,
      "track_total_hits": true,
      "query": {
        "match_all": {}
      },
      "aggs": {
        "por_indice": {
          "terms": {
            "field": "_index",
            "size": 100
          }
        }
      }
    }
  },
